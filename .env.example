# Generate a long random value locally; never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/store.db
FLASK_ENV=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-first-run

# Razorpay: leave blank to use the safe development checkout simulation.
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=

# SMTP: leave blank in development; emails will be written to the application log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true

# Optional storefront defaults
STORE_NAME=Sticker Studio
SHIPPING_FLAT_RATE=49
FREE_SHIPPING_THRESHOLD=499
MAX_CONTENT_LENGTH=5242880
